APP_NAME=Caller ID Platform
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./callerid.db
DEFAULT_COUNTRY=NL
CACHE_TTL_SECONDS=86400
MAX_BULK_ITEMS=150
DEFAULT_BULK_CONCURRENCY=4
REQUEST_TIMEOUT_SECONDS=12
NUMVERIFY_API_KEY=
NUMVERIFY_BASE_URL=https://api.apilayer.com/number_verification/validate
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search.json
KVK_API_KEY=
KVK_API_BASE_URL=https://api.kvk.nl/api/v2/zoeken
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_LOOKUP_BASE_URL=https://lookups.twilio.com/v2/PhoneNumbers
NUMLOOKUP_API_KEY=
NUMLOOKUP_API_BASE_URL=https://api.numlookupapi.com/v1/validate
CLEARBIT_API_KEY=
CLEARBIT_API_BASE_URL=https://person.clearbit.com/v2/combined/find
HUNTER_API_KEY=
HUNTER_API_BASE_URL=https://api.hunter.io/v2/phone-search
ENABLE_DDG_SCRAPING=true
RESPECT_ROBOTS=true
HTTP_USER_AGENT=BelRadar/1.0 (+https://belradar.local)
DDG_MAX_RESULTS=6
SEARCH_RETRY_ATTEMPTS=3
SEARCH_RETRY_DELAY_SECONDS=0.9
SEARCH_RATE_LIMIT_MS=950
SEARCH_REQUEST_TIMEOUT_SECONDS=15
CORS_ALLOWED_ORIGINS=*
